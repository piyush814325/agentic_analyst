{
    "buildCommand": "pip install -r requirements.txt",
    "outputDirectory": ".",
    "env": {
        "PYTHONUNBUFFERED": "1"
    },
    "functions": {
        "app.py": {
            "memory": 3008,
            "maxDuration": 60,
            "runtime": "python3.11"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/app.py"
        }
    ]
}