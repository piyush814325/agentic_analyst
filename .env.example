# Example environment variables for Agentic SQL Data Analyst
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Groq API Configuration
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Supabase configuration
# Get these from: https://supabase.com/dashboard
# Project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Optional: direct PostgreSQL connection string for server-side database work
# DATABASE_URL=postgresql://postgres:password@host.supabase.co:5432/postgres

# Application Configuration
LOG_LEVEL=INFO
APP_DEBUG=False

# Python Configuration (for Vercel)
PYTHONUNBUFFERED=1

# Optional: Custom database configuration
# DB_CONNECTION_STRING=mysql+pymysql://user:password@host:port/database

# Optional: Logging
# Set to DEBUG for more verbose logs
# LOG_LEVEL=DEBUG
